rule download_bed_as:
    input:
        fa_dir = config["fa_folder"]
    output:
        bed_dir = directory(os.path.join(WORKDIR, "data/annotations"))
    params:
        hprc_url = config["hprc_url"]
    log:
        "logs/download/download_as_anno.log"
    shell:
        r"""
        exec > {log} 2>&1

        mkdir -p {output.bed_dir}

        S3="{params.hprc_url}"

        for FA in {input.fa_dir}/*HG*.fa.gz {input.fa_dir}/*NA*.fa.gz; do
            BASE=$(basename "$FA" .fa.gz)
            IFS='_' read -r F1 F2 _ <<< "$BASE"
            IFS='.' read -r S1 S2 _ <<< "$F2"
            SAMPLE="$S1"
            SAMPLE_HAP="${{S1}}_${{S2}}"
            SAMPLE_FULL="${{F1}}_${{S1}}.${{S2}}"

            [ "$SAMPLE" = "HG002" ] && continue

            PFX="submissions/DC27718F-5F38-43B0-9A78-270F395F13E8--INT_ASM_PRODUCTION/${{SAMPLE}}/assemblies/freeze_2/annotation/censat/"
            KEY=$(curl -fsS "$S3/?list-type=2&prefix=$PFX" \
                | grep -o '<Key>[^<]*</Key>' | sed 's|</*Key>||g' \
                | grep "/${{SAMPLE_HAP}}_.*\.as_hor_sf\.bed$" | head -1)

            curl -fsSL -o {output.bed_dir}/"${{SAMPLE_FULL}}".as_hor_sf.bed "$S3/$KEY"
        done
        """

